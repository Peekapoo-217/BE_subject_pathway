# Spring Boot PostgreSQL configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/edu_guidance
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace_with_postgres_password

# Neo4j configuration
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_neo4j_password
NEO4J_DATABASE=edugraph

# CORS - cac origin FE duoc phep goi API, phan cach bang dau phay
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Province catalog used by the admin THPT document registration form.
PROVINCES_API_URL=https://34tinhthanh.com/api/provinces

# Authentication: set a random secret of at least 32 bytes. Initial admin is created once
# only when the database has no SUPER_ADMIN. Replace the bootstrap password before startup.
JWT_SECRET=replace_with_random_secret_at_least_32_bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Local HTTP only; production HTTPS MUST use true.
AUTH_COOKIE_SECURE=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s
AUTH_REDIS_KEY_PREFIX=subject-pathway:auth:
BOOTSTRAP_SUPER_ADMIN_USERNAME=adminsp
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace_with_a_strong_password

# Private S3-compatible storage. MinIO is the local Docker default; keep credentials local.
OBJECT_STORAGE_PROVIDER=MINIO
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_INTERNAL_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=thpt-school-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=replace_with_a_local_minio_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_with_a_strong_local_minio_secret
OBJECT_STORAGE_PRESIGNED_URL_TTL_SECONDS=300
# To select R2 later, set provider to R2 and point both endpoint values and credentials at the R2 bucket.
PDF_MAX_UPLOAD_BYTES=52428800
