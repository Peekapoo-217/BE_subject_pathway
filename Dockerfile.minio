FROM golang:1.24-alpine AS minio-build

ARG MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z

ENV CGO_ENABLED=0 \
    GOPATH=/go

RUN go install -v "github.com/minio/minio@${MINIO_RELEASE}"

FROM alpine:3.22

RUN apk add --no-cache ca-certificates

COPY --from=minio-build /go/bin/minio /usr/local/bin/minio

EXPOSE 9000 9001
VOLUME ["/data"]

ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
